{
  "expo": {
    "name": "Garlic Hub",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/garlic-logo-square.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.garlicbiz.w6hnht"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/garlic-adaptive.png",
        "backgroundColor": "#F4EFE8"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.garlicbiz.w6hnht",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router"
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/garlic-splash.png",
          "imageWidth": 290,
          "resizeMode": "contain",
          "backgroundColor": "#F4EFE8"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach photos of trader bills to your records",
          "cameraPermission": "Take a photo of trader bills at purchase"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fff2342f-44d5-448d-98f5-fa8cf0041d4d"
      }
    },
    "owner": "dhairya042"
  }
}
